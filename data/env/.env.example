# God's Eye View — claves API del despliegue Docker (god.movilab.es)
#
# 1) Copia este archivo a .env en esta misma carpeta:
#      cp data/env/.env.example data/env/.env
# 2) Rellena solo las que quieras (ninguna es obligatoria).
# 3) docker compose restart gev
#
# ⚠️ Este servidor es PÚBLICO: cualquiera que entre puede gastar tus claves.
#    El compose ya activa los rate-limits por IP del proyecto; pon además
#    presupuestos/alertas en OpenAI y Google Cloud.

# ── 3D fotorrealista + terreno (gratis, uso personal no comercial) ──
# https://cesium.com/ion — token público con restricción de URL
CESIUM_ION_TOKEN=

# ── Voz + resumen HUD (DE PAGO, por minuto de audio) ──
# https://platform.openai.com
OPENAI_API_KEY=

# ── Barcos en vivo (gratis) ──
# https://aisstream.io
AISSTREAM_API_KEY=

# ── Incendios activos NASA (gratis) ──
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# ── Tráfico real (gratis hasta ~50k tiles/día) ──
# https://developer.tomtom.com
TOMTOM_API_KEY=

# ── Más créditos de polling de vuelos (opcional; sin clave funciona anónimo) ──
# https://opensky-network.org
# OPENSKY_AUTH_MODE=anon
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=

# ── 3D directo de Google + búsqueda de lugares (medido) ──
# Restringir por HTTP referrer en Google Cloud Console
# GOOGLE_MAPS_API_KEY=

# ── Lanzamientos espaciales: más cuota (opcional) ──
# LL2_API_TOKEN=
